{
  "name": "pi-telegram",
  "version": "0.1.0",
  "description": "Host-neutral Telegram messaging extension for Pi-compatible agents",
  "type": "module",
  "keywords": [
    "pi-package",
    "telegram"
  ],
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "config.example.json"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "ky": "^1.8.2",
    "typebox": "^1.3.10",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@code-yeongyu/senpi": "2026.8.4",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@types/bun": "^1.2.20",
    "typescript": "^5.9.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
